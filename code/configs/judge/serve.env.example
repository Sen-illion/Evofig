# Point every Judge caller at a checkpoint we trained, instead of a vendor endpoint.
#
#   set -a; . configs/judge/serve.env.example; set +a
#
# API_BASE is the only thing that decides where the Judge is reached: the pipeline posts an
# OpenAI-shaped chat request to {API_BASE}/chat/completions, so the same value serves the
# evolution loop, the baseline batch, the shadow comparison and the handover.
#
# API_KEY is required by the client and nothing more; a local server has no account to
# authenticate, so keep it a literal and never reuse a vendor key here.
API_BASE=http://127.0.0.1:8000/v1
API_KEY=local
# The name the local server reports in --served-model-name.
RFS_ONLINE_JUDGE_MODEL=judge-pilot-v001
RFS_FROZEN_JUDGE_MODEL=judge-pilot-v001
